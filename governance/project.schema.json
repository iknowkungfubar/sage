{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-project-governance-v1.json",
  "title": "Agent project verification configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "root", "gates", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "sourceOfTruth": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "protectedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "generatedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOnTrackedChangeDuringVerification": { "type": "boolean" },
        "reportOutputLimitBytes": { "type": "integer", "minimum": 1000, "maximum": 1000000 }
      }
    },
    "riskTriggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier2": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tier3": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "uniqueItems": true
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "command", "required", "timeoutSeconds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
